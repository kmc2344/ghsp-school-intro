---
import Layout from '../layouts/Layout.astro';

const base = import.meta.env.BASE_URL;
const basePath = base.endsWith('/') ? base : `${base}/`;
---

<Layout
  title="404 | 神山まるごと高専紹介ページ"
  description="指定されたページは見つかりませんでした。トップページから神山まるごと高専の紹介をご覧ください。"
>
  <main class="not-found-page section-frame">
    <p class="eyebrow-text">404 / Not Found</p>
    <h1>探しているページは見つかりません。</h1>
    <p>
      公開構成は現在1ページです。トップへ戻って、学校概要、カリキュラム、学生生活をご覧ください。
    </p>
    <a class="button-primary" href={`${basePath}#top`}>トップへ戻る</a>
  </main>
</Layout>
